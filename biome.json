{
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!node_modules",
      "!!dist",
      "!!package/contents/code",
      "!!package-lock.json",
      "!!tests/*.qml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useArrowFunction": "off"
      },
      "style": {
        "noDescendingSpecificity": "off",
        "useTemplate": "off"
      }
    }
  },
  "assist": {
    "enabled": false
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  }
}
